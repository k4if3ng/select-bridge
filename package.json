{
  "name": "select-bridge",
  "version": "1.2.1",
  "description": "Forward globally selected text to a configurable URL target.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "build:windows:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1 -SkipSetup",
    "build:windows:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-setup.ps1",
    "check:native": "node scripts/check-native.cjs",
    "test": "pnpm build && node --test test/config.test.mjs test/url-target.test.mjs test/update-checker.test.mjs",
    "start": "tsc -p tsconfig.json && node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "dependencies": {
    "selection-hook": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "node-gyp": "13.0.1",
    "postject": "1.0.0-alpha.6",
    "rcedit": "^5.0.2",
    "typescript": "^5.7.0"
  }
}
