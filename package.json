{
  "name": "selection-forward",
  "version": "1.0.0",
  "description": "Forward globally selected text to GoldenDict-ng.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "check:native": "node scripts/check-native.cjs",
    "start": "tsc -p tsconfig.json && node dist/index.js --headless",
    "start:tray": "tsc -p tsconfig.json && node dist/index.js --tray"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "dependencies": {
    "selection-hook": "^2.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "node-gyp": "13.0.1",
    "typescript": "^5.7.0"
  }
}
